[Unit]
Description=Dynamic Load Balancer for Group Chat App
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/lb
# Set the real token here (or better, in an EnvironmentFile= that is
# chmod 600 and NOT checked into version control) rather than in
# config.json, so it never ends up committed alongside the rest of the
# LB config.
Environment=ADMIN_TOKEN=k3x9P2vQ8mZ7rL4tY6wN1sB5
ExecStart=/opt/lb/lb -config /opt/lb/config.json
Restart=always
RestartSec=2
User=lbrunner
Group=lbrunner
LimitNOFILE=65536
# Keep stdout/stderr in the journal for debugging with: journalctl -u lb -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
